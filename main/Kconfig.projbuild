menu "ESPESP Menu"

choice CASE2_SELECTED_MODULE
    prompt "Module selector"
    default CASE2_MODULE_SYSTEM_INFO
    help
        Select one module to run after boot. This project is designed for
        single-module learning: switch here, rebuild, flash, and watch serial
        logs or the connected hardware.

config CASE2_MODULE_SYSTEM_INFO
    bool "system_info: chip/app/heap information"

config CASE2_MODULE_RTOS_TASKS
    bool "rtos_tasks: tasks and queue"

config CASE2_MODULE_LED_BLINK
    bool "led_blink: LED GPIO output"

config CASE2_MODULE_NVS_COUNTER
    bool "nvs_counter: persistent boot counter"

config CASE2_MODULE_WIFI_STATION
    bool "wifi_station: connect to Wi-Fi"

config CASE2_MODULE_HTTP_GET
    bool "http_get: Wi-Fi + HTTP GET"

config CASE2_MODULE_ADC_READER
    bool "adc_reader: read ADC1 channel"

config CASE2_MODULE_UART_ECHO
    bool "uart_echo: UART read/write"

config CASE2_MODULE_I2C_SCAN
    bool "i2c_scan: scan I2C addresses"

config CASE2_MODULE_MICROPHONE
    bool "microphone: read I2S microphone frames"

config CASE2_MODULE_SPEAKER
    bool "speaker: play I2S sine tone"

config CASE2_MODULE_DISPLAY
    bool "display: write SSD1306 OLED pattern"

endchoice

menu "FreeRTOS task module"

config CASE2_FREERTOS_QUEUE_LENGTH
    int "Queue length"
    range 1 32
    default 5

config CASE2_FREERTOS_PRODUCER_PERIOD_MS
    int "Producer period in ms"
    range 50 10000
    default 1000

endmenu

menu "LED module"

config CASE2_LED_GPIO
    int "LED GPIO number"
    range 0 48 if IDF_TARGET_ESP32S3
    range 0 39
    default 2
    help
        Set this to the LED GPIO of your board. Many ESP32 boards use GPIO2,
        while some ESP32-S3 boards use GPIO48 or another board-specific pin.

config CASE2_LED_PERIOD_MS
    int "LED blink period in ms"
    range 50 10000
    default 500

endmenu

menu "NVS module"

config CASE2_NVS_NOTE
    string "Note"
    default "Run this module, reset the board, and watch boot_count increase."
    help
        This text is only here to make the menu self-documenting.

endmenu

menu "WiFi module"

config CASE2_WIFI_SSID
    string "WiFi SSID"
    default ""
    help
        The WiFi network name used by the station and HTTP modules.

config CASE2_WIFI_PASSWORD
    string "WiFi password"
    default ""
    help
        The WiFi password. Leave it empty only for an open network.

config CASE2_WIFI_MAXIMUM_RETRY
    int "Maximum WiFi retries"
    range 1 20
    default 5
    help
        Maximum reconnect attempts before wifi_station_connect returns ESP_FAIL.

endmenu

menu "HTTP client module"

config CASE2_HTTP_URL
    string "HTTP GET URL"
    default "http://httpbin.org/get"
    help
        Use http:// for the first networking lesson. HTTPS requires certificate
        handling, which is a later topic.

config CASE2_HTTP_TIMEOUT_MS
    int "HTTP timeout in ms"
    range 1000 30000
    default 5000

config CASE2_HTTP_PRINT_LIMIT
    int "Maximum response bytes printed"
    range 0 4096
    default 512

endmenu

menu "ADC reader module"

config CASE2_ADC_CHANNEL
    int "ADC1 channel"
    range 0 9 if IDF_TARGET_ESP32S3
    range 0 10
    default 2
    help
        This is an ADC channel number, not a GPIO number. On ESP32-S3,
        ADC1 channel 2 maps to GPIO3.

config CASE2_ADC_PERIOD_MS
    int "ADC read period in ms"
    range 100 10000
    default 1000

endmenu

menu "UART echo module"

config CASE2_UART_PORT_NUM
    int "UART port number"
    range 0 2
    default 1

config CASE2_UART_BAUD_RATE
    int "UART baud rate"
    range 1200 2000000
    default 115200

config CASE2_UART_USE_CUSTOM_PINS
    bool "Use custom TX/RX GPIO pins"
    default y

config CASE2_UART_TX_GPIO
    int "UART TX GPIO"
    depends on CASE2_UART_USE_CUSTOM_PINS
    range 0 48 if IDF_TARGET_ESP32S3
    range 0 39
    default 17

config CASE2_UART_RX_GPIO
    int "UART RX GPIO"
    depends on CASE2_UART_USE_CUSTOM_PINS
    range 0 48 if IDF_TARGET_ESP32S3
    range 0 39
    default 18

endmenu

menu "I2C scan module"

config CASE2_I2C_SDA_GPIO
    int "I2C SDA GPIO"
    range 0 48 if IDF_TARGET_ESP32S3
    range 0 39
    default 8

config CASE2_I2C_SCL_GPIO
    int "I2C SCL GPIO"
    range 0 48 if IDF_TARGET_ESP32S3
    range 0 39
    default 9

config CASE2_I2C_PROBE_TIMEOUT_MS
    int "Probe timeout in ms"
    range 1 1000
    default 50

endmenu

menu "Microphone module"

config CASE2_MIC_BCLK_GPIO
    int "I2S microphone BCLK GPIO"
    range 0 48 if IDF_TARGET_ESP32S3
    range 0 39
    default 4

config CASE2_MIC_WS_GPIO
    int "I2S microphone WS/LRCLK GPIO"
    range 0 48 if IDF_TARGET_ESP32S3
    range 0 39
    default 5

config CASE2_MIC_DIN_GPIO
    int "I2S microphone DATA input GPIO"
    range 0 48 if IDF_TARGET_ESP32S3
    range 0 39
    default 6

config CASE2_MIC_SAMPLE_RATE_HZ
    int "I2S microphone sample rate"
    range 8000 48000
    default 16000

endmenu

menu "Speaker module"

config CASE2_SPK_BCLK_GPIO
    int "I2S speaker BCLK GPIO"
    range 0 48 if IDF_TARGET_ESP32S3
    range 0 39
    default 10

config CASE2_SPK_WS_GPIO
    int "I2S speaker WS/LRCLK GPIO"
    range 0 48 if IDF_TARGET_ESP32S3
    range 0 39
    default 11

config CASE2_SPK_DOUT_GPIO
    int "I2S speaker DATA output GPIO"
    range 0 48 if IDF_TARGET_ESP32S3
    range 0 39
    default 12

config CASE2_SPK_SAMPLE_RATE_HZ
    int "I2S speaker sample rate"
    range 8000 48000
    default 16000

config CASE2_SPK_TONE_HZ
    int "Sine tone frequency"
    range 100 3000
    default 440

endmenu

menu "Display module"

config CASE2_DISPLAY_SDA_GPIO
    int "Display I2C SDA GPIO"
    range 0 48 if IDF_TARGET_ESP32S3
    range 0 39
    default 8

config CASE2_DISPLAY_SCL_GPIO
    int "Display I2C SCL GPIO"
    range 0 48 if IDF_TARGET_ESP32S3
    range 0 39
    default 9

config CASE2_DISPLAY_I2C_ADDR
    hex "Display I2C address"
    range 0x03 0x77
    default 0x3C
    help
        SSD1306 OLED modules commonly use 0x3C or 0x3D.

config CASE2_DISPLAY_I2C_HZ
    int "Display I2C clock"
    range 100000 400000
    default 400000

config CASE2_DISPLAY_TIMEOUT_MS
    int "Display I2C timeout in ms"
    range 10 1000
    default 100

endmenu

endmenu
