menu "ESPESP Menu"

config ESPESP_HTTPD_WEBSOCKET_SUPPORT
    bool
    default y
    select HTTPD_WS_SUPPORT
    select HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT
    select HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT
    help
        websocket_server.c is compiled with the app component even when another
        module is selected, so the ESP-IDF HTTP server WebSocket structs and
        APIs must always be available to this project.

choice ESPESP_SELECTED_MODULE
    prompt "Module selector"
    default ESPESP_MODULE_SYSTEM_INFO
    help
        Select one module to run after boot. This project is designed for
        single-module operation: switch here, rebuild, flash, and watch serial
        logs, network endpoints, or the connected hardware.

config ESPESP_MODULE_SYSTEM_INFO
    bool "system_info: chip/app/heap information"

config ESPESP_MODULE_RTOS_TASKS
    bool "rtos_tasks: tasks and queue"

config ESPESP_MODULE_LED_BLINK
    bool "led_blink: LED GPIO output"

config ESPESP_MODULE_NVS_COUNTER
    bool "nvs_counter: persistent boot counter"

config ESPESP_MODULE_WIFI_STATION
    bool "wifi_station: connect to Wi-Fi"

config ESPESP_MODULE_HTTP_GET
    bool "http_get: Wi-Fi + HTTP GET"

config ESPESP_MODULE_ADC_READER
    bool "adc_reader: read ADC1 channel"

config ESPESP_MODULE_UART_ECHO
    bool "uart_echo: UART read/write"

config ESPESP_MODULE_I2C_SCAN
    bool "i2c_scan: scan I2C addresses"

config ESPESP_MODULE_MICROPHONE
    bool "microphone: read I2S microphone frames"

config ESPESP_MODULE_PCM_STREAM
    bool "pcm_stream: stream microphone PCM to computer"

config ESPESP_MODULE_SPEAKER
    bool "speaker: play I2S sine tone"

config ESPESP_MODULE_SPEAKER_CLIENT
    bool "speaker_client: Wi-Fi + WebSocket audio playback"

config ESPESP_MODULE_VOICE_CALLBACK
    bool "voice_callback: full-duplex microphone monitor with echo guard"

config ESPESP_MODULE_VOICE_CLIENT
    bool "voice_client: microphone -> voice-server -> speaker"

config ESPESP_MODULE_DISPLAY
    bool "display: write SSD1306 OLED pattern"

config ESPESP_MODULE_MQTT_CLIENT
    bool "mqtt_client: Wi-Fi + MQTT publish/subscribe"

config ESPESP_MODULE_HTTP_SERVER
    bool "http_server: production-style LAN HTTP service"

config ESPESP_MODULE_HTTPS_SERVER
    bool "https_server: secure LAN HTTPS service"

config ESPESP_MODULE_WEBSOCKET_SERVER
    bool "websocket_server: WebSocket upgrade service"
    select HTTPD_WS_SUPPORT
    select HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT
    select HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT

config ESPESP_MODULE_WEBSOCKET_CLIENT
    bool "websocket_client: Wi-Fi + WebSocket client"

endchoice

menu "FreeRTOS task module"

config ESPESP_FREERTOS_QUEUE_LENGTH
    int "Queue length"
    range 1 32
    default 5

config ESPESP_FREERTOS_PRODUCER_PERIOD_MS
    int "Producer period in ms"
    range 50 10000
    default 1000

endmenu

menu "LED module"

config ESPESP_LED_GPIO
    int "LED GPIO number"
    range 0 48 if IDF_TARGET_ESP32S3
    range 0 39
    default 2
    help
        Set this to the LED GPIO of your board. Many ESP32 boards use GPIO2,
        while some ESP32-S3 boards use GPIO48 or another board-specific pin.

config ESPESP_LED_PERIOD_MS
    int "LED blink period in ms"
    range 50 10000
    default 500

endmenu

menu "NVS module"

config ESPESP_NVS_NOTE
    string "Note"
    default "Run this module, reset the board, and watch boot_count increase."
    help
        This text is only here to make the menu self-documenting.

endmenu

menu "WiFi module"

config ESPESP_WIFI_SSID
    string "WiFi SSID"
    default ""
    help
        The WiFi network name used by the station and HTTP modules.

config ESPESP_WIFI_PASSWORD
    string "WiFi password"
    default ""
    help
        The WiFi password. Leave it empty only for an open network.

config ESPESP_WIFI_MAXIMUM_RETRY
    int "Maximum WiFi retries"
    range 1 20
    default 5
    help
        Maximum reconnect attempts before wifi_station_connect returns ESP_FAIL.

endmenu

menu "HTTP client module"

config ESPESP_HTTP_URL
    string "HTTP GET URL"
    default "http://httpbin.org/get"
    help
        Use http:// for the first networking lesson. HTTPS requires certificate
        handling, which is a later topic.

config ESPESP_HTTP_TIMEOUT_MS
    int "HTTP timeout in ms"
    range 1000 30000
    default 5000

config ESPESP_HTTP_PRINT_LIMIT
    int "Maximum response bytes printed"
    range 0 4096
    default 512

endmenu

menu "LAN service"

config ESPESP_LAN_SERVICE_REQUIRE_AUTH
    bool "Require bearer token for control/status APIs"
    default y
    help
        Keep enabled for LAN deployments. /health remains public, while
        /api/v1/status and /api/v1/control require Authorization: Bearer <token>.

config ESPESP_LAN_SERVICE_AUTH_TOKEN
    string "Bearer token"
    default ""
    help
        Set a strong token before exposing the LAN service. HTTP server startup
        fails when auth is required and this value is empty.

config ESPESP_LAN_SERVICE_MAX_BODY_LEN
    int "Maximum POST body bytes"
    range 64 1024
    default 256

config ESPESP_LAN_SERVICE_RECV_TIMEOUT_SEC
    int "Receive timeout in seconds"
    range 1 30
    default 5

config ESPESP_LAN_SERVICE_SEND_TIMEOUT_SEC
    int "Send timeout in seconds"
    range 1 30
    default 5

endmenu

menu "HTTP server module"

config ESPESP_HTTP_SERVER_PORT
    int "HTTP server port"
    range 1 65535
    default 80

config ESPESP_HTTP_SERVER_CTRL_PORT
    int "HTTP server control port"
    range 1 65535
    default 32768
    help
        Internal control socket used by esp_http_server. Keep it different
        from the public HTTP server port.

config ESPESP_HTTP_SERVER_STACK_SIZE
    int "HTTP server task stack size"
    range 4096 16384
    default 4096

config ESPESP_HTTP_SERVER_MAX_OPEN_SOCKETS
    int "Maximum open sockets"
    range 1 8
    default 4

endmenu

menu "HTTPS server module"

config ESPESP_HTTPS_SERVER_PORT
    int "HTTPS server port"
    range 1 65535
    default 443

config ESPESP_HTTPS_SERVER_CTRL_PORT
    int "HTTPS server control port"
    range 1 65535
    default 32769
    help
        Internal control socket used by esp_https_server. Keep it different
        from HTTP and HTTPS public ports.

config ESPESP_HTTPS_SERVER_STACK_SIZE
    int "HTTPS server task stack size"
    range 8192 32768
    default 12288

config ESPESP_HTTPS_SERVER_MAX_OPEN_SOCKETS
    int "Maximum open TLS sockets"
    range 1 4
    default 3

config ESPESP_HTTPS_HANDSHAKE_TIMEOUT_MS
    int "TLS handshake timeout in ms"
    range 1000 30000
    default 10000

config ESPESP_HTTPS_CERT_NVS_NAMESPACE
    string "NVS namespace for TLS credentials"
    default "https_srv"

config ESPESP_HTTPS_CERT_NVS_CERT_KEY
    string "NVS key for server certificate PEM"
    default "servercert"

config ESPESP_HTTPS_CERT_NVS_PRIVATE_KEY
    string "NVS key for private key PEM"
    default "prvtkey"

endmenu

menu "WebSocket server module"

config ESPESP_WS_SERVER_PORT
    int "WebSocket server port"
    range 1 65535
    default 8080

config ESPESP_WS_SERVER_CTRL_PORT
    int "WebSocket server control port"
    range 1 65535
    default 32770
    help
        Internal control socket used by esp_http_server. Keep it different
        from the public WebSocket server port and the HTTP/HTTPS control ports.

config ESPESP_WS_SERVER_PATH
    string "WebSocket path"
    default "/ws"
    help
        The URI used for the WebSocket upgrade request.

config ESPESP_WS_SERVER_AUTH_TOKEN
    string "Bearer token"
    default ""
    help
        Leave empty to allow open access. When set, clients must send
        Authorization: Bearer <token> during the handshake.

config ESPESP_WS_SERVER_PUBLISH_PERIOD_MS
    int "Status publish period in ms"
    range 100 60000
    default 1000
    help
        Periodic status JSON is pushed to connected clients as a heartbeat.

config ESPESP_WS_SERVER_MAX_CLIENTS
    int "Maximum WebSocket clients"
    range 1 8
    default 4
    help
        The server rejects new handshakes once this many WebSocket clients are
        already connected.

endmenu

menu "WebSocket client module"

config ESPESP_WS_CLIENT_URI
    string "WebSocket server URI"
    default "ws://192.168.1.23:8080/ws"
    help
        Use your computer's LAN IP when testing with server/ws_server/.
        Do not use 127.0.0.1 from the ESP32.

config ESPESP_WS_CLIENT_AUTH_TOKEN
    string "Bearer token"
    default ""
    help
        Leave empty for open endpoints. When set, the client sends
        Authorization: Bearer <token> during the handshake.

config ESPESP_WS_CLIENT_INITIAL_PAYLOAD
    string "Initial text payload"
    default "hello from espesp websocket_client"
    help
        Sent once after the connection is established. Leave empty to skip it.

config ESPESP_WS_CLIENT_PUBLISH_PERIOD_MS
    int "Status publish period in ms"
    range 500 60000
    default 5000
    help
        Periodic status JSON is sent while the WebSocket connection is up.

config ESPESP_WS_CLIENT_CONNECT_TIMEOUT_MS
    int "Connect timeout in ms"
    range 1000 60000
    default 10000

config ESPESP_WS_CLIENT_NETWORK_TIMEOUT_MS
    int "Network operation timeout in ms"
    range 1000 30000
    default 5000

config ESPESP_WS_CLIENT_RECONNECT_TIMEOUT_MS
    int "Reconnect delay in ms"
    range 1000 60000
    default 10000

config ESPESP_WS_CLIENT_PING_INTERVAL_SEC
    int "Ping interval in seconds"
    range 1 300
    default 10

config ESPESP_WS_CLIENT_BUFFER_SIZE
    int "Receive buffer size"
    range 256 8192
    default 1024

config ESPESP_WS_CLIENT_TASK_STACK_SIZE
    int "WebSocket client task stack size"
    range 4096 16384
    default 6144

endmenu

menu "MQTT client module"

config ESPESP_MQTT_BROKER_URI
    string "MQTT broker URI"
    default "mqtt://192.168.1.23:1883"
    help
        Use your computer's LAN IP when testing with server/mqtt_broker/.
        Do not use 127.0.0.1 from the ESP32.

config ESPESP_MQTT_CLIENT_ID
    string "MQTT client ID"
    default "espesp-esp32"

config ESPESP_MQTT_STATUS_TOPIC
    string "Status publish topic"
    default "espesp/device/status"

config ESPESP_MQTT_CMD_TOPIC
    string "Command subscribe topic"
    default "espesp/device/cmd"

config ESPESP_MQTT_PUBLISH_PERIOD_MS
    int "Status publish period in ms"
    range 1000 600000
    default 5000

config ESPESP_MQTT_CONNECT_TIMEOUT_MS
    int "Connect timeout in ms"
    range 1000 60000
    default 10000

config ESPESP_MQTT_KEEPALIVE_SEC
    int "MQTT keepalive in seconds"
    range 5 300
    default 60

endmenu

menu "ADC reader module"

config ESPESP_ADC_CHANNEL
    int "ADC1 channel"
    range 0 9 if IDF_TARGET_ESP32S3
    range 0 10
    default 2
    help
        This is an ADC channel number, not a GPIO number. On ESP32-S3,
        ADC1 channel 2 maps to GPIO3.

config ESPESP_ADC_PERIOD_MS
    int "ADC read period in ms"
    range 100 10000
    default 1000

endmenu

menu "UART echo module"

config ESPESP_UART_PORT_NUM
    int "UART port number"
    range 0 2
    default 1

config ESPESP_UART_BAUD_RATE
    int "UART baud rate"
    range 1200 2000000
    default 115200

config ESPESP_UART_USE_CUSTOM_PINS
    bool "Use custom TX/RX GPIO pins"
    default y

config ESPESP_UART_TX_GPIO
    int "UART TX GPIO"
    depends on ESPESP_UART_USE_CUSTOM_PINS
    range 0 48 if IDF_TARGET_ESP32S3
    range 0 39
    default 17

config ESPESP_UART_RX_GPIO
    int "UART RX GPIO"
    depends on ESPESP_UART_USE_CUSTOM_PINS
    range 0 48 if IDF_TARGET_ESP32S3
    range 0 39
    default 18

endmenu

menu "I2C scan module"

config ESPESP_I2C_SDA_GPIO
    int "I2C SDA GPIO"
    range 0 48 if IDF_TARGET_ESP32S3
    range 0 39
    default 8

config ESPESP_I2C_SCL_GPIO
    int "I2C SCL GPIO"
    range 0 48 if IDF_TARGET_ESP32S3
    range 0 39
    default 9

config ESPESP_I2C_PROBE_TIMEOUT_MS
    int "Probe timeout in ms"
    range 1 1000
    default 50

endmenu

menu "Microphone module"

config ESPESP_MIC_BCLK_GPIO
    int "I2S microphone BCLK GPIO"
    range 0 48 if IDF_TARGET_ESP32S3
    range 0 39
    default 4

config ESPESP_MIC_WS_GPIO
    int "I2S microphone WS/LRCLK GPIO"
    range 0 48 if IDF_TARGET_ESP32S3
    range 0 39
    default 5

config ESPESP_MIC_DIN_GPIO
    int "I2S microphone DATA input GPIO"
    range 0 48 if IDF_TARGET_ESP32S3
    range 0 39
    default 6

config ESPESP_MIC_SAMPLE_RATE_HZ
    int "I2S microphone sample rate"
    range 8000 48000
    default 16000

endmenu

menu "PCM stream module"

choice ESPESP_PCM_STREAM_TRANSPORT
    prompt "PCM stream transport"
    default ESPESP_PCM_STREAM_TRANSPORT_UART
    help
        UART is the simplest flash-free path when your computer has a USB-UART
        adapter connected to the ESP TX pin. UDP uses Wi-Fi and sends packets
        to a Python recorder listening on your computer.

config ESPESP_PCM_STREAM_TRANSPORT_UART
    bool "UART"

config ESPESP_PCM_STREAM_TRANSPORT_UDP
    bool "Wi-Fi UDP"

endchoice

config ESPESP_PCM_UART_PORT_NUM
    int "PCM UART port number"
    range 0 2
    default 1

config ESPESP_PCM_UART_BAUD_RATE
    int "PCM UART baud rate"
    range 1200 3000000
    default 921600
    help
        16 kHz mono 16-bit PCM needs about 256 kbit/s before framing overhead.
        921600 baud leaves enough margin for continuous recording.

config ESPESP_PCM_UART_USE_CUSTOM_PINS
    bool "Use custom PCM UART TX/RX GPIO pins"
    default y

config ESPESP_PCM_UART_TX_GPIO
    int "PCM UART TX GPIO"
    range 0 48 if IDF_TARGET_ESP32S3
    range 0 39
    default 17

config ESPESP_PCM_UART_RX_GPIO
    int "PCM UART RX GPIO"
    range 0 48 if IDF_TARGET_ESP32S3
    range 0 39
    default 18

config ESPESP_PCM_UDP_HOST
    string "UDP recorder IPv4 address"
    default "255.255.255.255"
    help
        Use 255.255.255.255 to broadcast to the local Wi-Fi/LAN, which is the
        easiest way to avoid choosing the wrong computer IP. You can also set
        this to the computer's LAN IPv4 address for unicast. Do not use
        127.0.0.1 from ESP32.

config ESPESP_PCM_UDP_PORT
    int "Computer UDP port"
    range 1 65535
    default 8765

config ESPESP_PCM_FRAME_SAMPLES
    int "PCM samples per packet"
    range 64 512
    default 128
    help
        Smaller packets reduce UDP/lwIP memory pressure. 128 samples at
        16 kHz is 8 ms of audio and keeps each packet below 300 bytes.

choice ESPESP_PCM_INPUT_SLOT
    prompt "PCM input I2S slot"
    default ESPESP_PCM_INPUT_SLOT_LEFT
    help
        Select the I2S slot used by the microphone. Only one slot is sent as
        mono PCM. Enabling both slots would double the recorded sample count
        while the WAV header still says 16 kHz, making a 10 second recording
        play for about 20 seconds.

config ESPESP_PCM_INPUT_SLOT_LEFT
    bool "Left"

config ESPESP_PCM_INPUT_SLOT_RIGHT
    bool "Right"

endchoice

config ESPESP_PCM_SAMPLE_SHIFT_BITS
    int "PCM sample right shift bits"
    range 8 16
    default 12
    help
        Controls how 32-bit I2S microphone samples are scaled down to 16-bit
        WAV PCM. Lower values are louder and may clip; higher values are
        quieter. Use 12 as a balanced starting point, 10 or 11 if recordings
        are too quiet, and 13 or 14 if they still sound clipped.

endmenu

menu "Speaker module"

config ESPESP_SPK_BCLK_GPIO
    int "I2S speaker BCLK GPIO"
    range 0 48 if IDF_TARGET_ESP32S3
    range 0 39
    default 10

config ESPESP_SPK_WS_GPIO
    int "I2S speaker WS/LRCLK GPIO"
    range 0 48 if IDF_TARGET_ESP32S3
    range 0 39
    default 11

config ESPESP_SPK_DOUT_GPIO
    int "I2S speaker DATA output GPIO"
    range 0 48 if IDF_TARGET_ESP32S3
    range 0 39
    default 12

config ESPESP_SPK_SAMPLE_RATE_HZ
    int "I2S speaker sample rate"
    range 8000 48000
    default 16000

config ESPESP_SPK_TONE_HZ
    int "Sine tone frequency"
    range 100 3000
    default 440

endmenu

menu "Speaker client module"

config ESPESP_SPEAKER_CLIENT_URI
    string "speaker_server WebSocket URI"
    default "ws://192.168.1.23:8082/audio"
    help
        Use your computer's LAN IP when testing with server/speaker_server/.
        Do not use 127.0.0.1 from the ESP32.

config ESPESP_SPEAKER_CLIENT_AUTH_TOKEN
    string "Bearer token"
    default ""
    help
        Leave empty for open endpoints. When set, the client sends
        Authorization: Bearer <token> during the handshake.

config ESPESP_SPEAKER_CLIENT_STATUS_PERIOD_MS
    int "Status publish period in ms"
    range 1000 60000
    default 5000

config ESPESP_SPEAKER_CLIENT_CONNECT_TIMEOUT_MS
    int "Connect timeout in ms"
    range 1000 60000
    default 10000

config ESPESP_SPEAKER_CLIENT_NETWORK_TIMEOUT_MS
    int "Network operation timeout in ms"
    range 1000 30000
    default 5000

config ESPESP_SPEAKER_CLIENT_RECONNECT_TIMEOUT_MS
    int "Reconnect delay in ms"
    range 1000 60000
    default 10000

config ESPESP_SPEAKER_CLIENT_PING_INTERVAL_SEC
    int "Ping interval in seconds"
    range 1 300
    default 10

config ESPESP_SPEAKER_CLIENT_BUFFER_SIZE
    int "Receive buffer size"
    range 512 8192
    default 2048
    help
        The Python speaker_server defaults to 1024-byte PCM chunks. Larger
        buffers reduce WebSocket fragmentation, while fragmented chunks are
        still handled safely by the client.

config ESPESP_SPEAKER_CLIENT_TASK_STACK_SIZE
    int "WebSocket client task stack size"
    range 4096 24576
    default 8192

config ESPESP_SPEAKER_CLIENT_I2S_WRITE_TIMEOUT_MS
    int "I2S write timeout in ms"
    range 100 5000
    default 1000

endmenu

menu "Voice callback module"

config ESPESP_VOICE_CALLBACK_SAMPLE_RATE_HZ
    int "Voice callback sample rate"
    range 8000 48000
    default 16000
    help
        Shared I2S sample rate for microphone capture and speaker playback.
        Keeping RX and TX at the same rate avoids resampling in this local
        full-duplex monitor.

config ESPESP_VOICE_CALLBACK_FRAME_SAMPLES
    int "Voice callback frame samples"
    range 64 512
    default 160
    help
        Number of mono samples moved per frame from capture to playback.
        At 16 kHz, 160 samples is 10 ms.

config ESPESP_VOICE_CALLBACK_QUEUE_LENGTH
    int "Voice callback frame queue length"
    range 2 16
    default 6
    help
        Number of preallocated PCM frames between capture and playback.
        The playback path keeps only a short newest-frame backlog so local
        monitor latency stays low without dropping every scheduler hiccup.

choice ESPESP_VOICE_CALLBACK_MIC_SLOT
    prompt "Voice callback microphone I2S slot"
    default ESPESP_VOICE_CALLBACK_MIC_SLOT_LEFT
    help
        Select the I2S slot used by the microphone.

config ESPESP_VOICE_CALLBACK_MIC_SLOT_LEFT
    bool "Left"

config ESPESP_VOICE_CALLBACK_MIC_SLOT_RIGHT
    bool "Right"

endchoice

config ESPESP_VOICE_CALLBACK_MIC_SAMPLE_SHIFT_BITS
    int "Microphone sample right shift bits"
    range 8 16
    default 12
    help
        Controls how 32-bit I2S microphone samples are scaled down to 16-bit
        PCM. Lower values are louder and may clip; higher values are quieter.

config ESPESP_VOICE_CALLBACK_MIC_INPUT_LIMIT_PERCENT
    int "Microphone input limiter percent"
    range 50 100
    default 85
    help
        Peak headroom kept while converting microphone samples to 16-bit PCM.
        This applies a linear per-frame gain reduction before saturation, so
        loud microphone frames do not clip before playback volume is applied.

config ESPESP_VOICE_CALLBACK_PLAYBACK_VOLUME_PERCENT
    int "Playback volume percent"
    range 1 100
    default 15
    help
        Digital gain applied to microphone PCM before writing to the speaker.
        Lower this value if the monitor rings, feeds back, or distorts.

config ESPESP_VOICE_CALLBACK_PLAYBACK_LIMIT_PERCENT
    int "Playback soft limit percent"
    range 10 100
    default 80
    help
        Peak limiter applied after playback volume scaling.

config ESPESP_VOICE_CALLBACK_AEC_ENABLED
    bool "Enable acoustic echo cancellation (AEC)"
    default n
    help
        Optional experimental NLMS echo canceller. It is disabled by default
        because the local callback business path prioritizes low CPU use and
        hard anti-feedback gating over a heavy adaptive filter.

config ESPESP_VOICE_CALLBACK_AEC_FILTER_LEN
    int "AEC filter length (taps)"
    range 32 256
    default 64
    depends on ESPESP_VOICE_CALLBACK_AEC_ENABLED
    help
        More taps can model longer speaker-to-microphone echo paths, but use
        more CPU.

config ESPESP_VOICE_CALLBACK_AEC_STEP_SIZE_X256
    int "AEC step size (scaled by 256)"
    range 1 256
    default 64
    depends on ESPESP_VOICE_CALLBACK_AEC_ENABLED
    help
        NLMS convergence speed. Keep this conservative on ESP32-class parts.

config ESPESP_VOICE_CALLBACK_AEC_MAX_DELAY_MS
    int "AEC max acoustic delay in ms"
    range 10 500
    default 80
    depends on ESPESP_VOICE_CALLBACK_AEC_ENABLED
    help
        Extra reference history kept for acoustic and queue delay.

config ESPESP_VOICE_CALLBACK_AEC_REFERENCE_DELAY_MS
    int "AEC reference delay in ms"
    range 0 500
    default 40
    depends on ESPESP_VOICE_CALLBACK_AEC_ENABLED
    help
        Fixed delay used when matching the speaker reference to the microphone
        echo. Increase it if the speaker is far from the microphone or if the
        frame queue is deeper; decrease it if near-end speech sounds gated.

config ESPESP_VOICE_CALLBACK_NOISE_GATE_AVG_ABS
    int "Residual noise gate average amplitude"
    range 0 5000
    default 120
    help
        Frames whose average absolute amplitude is below this value are
        replaced with silence before playback.

config ESPESP_VOICE_CALLBACK_ECHO_GATE_PERCENT
    int "Residual echo gate percent"
    range 0 1000
    default 500
    help
        While the speaker was recently audible, the microphone frame must clear
        this percentage of the last playback average amplitude. Raising this
        value rejects more speaker leakage; lowering it makes the monitor more
        open.

config ESPESP_VOICE_CALLBACK_SPEAKER_ACTIVE_TIMEOUT_MS
    int "Speaker active gate window in ms"
    range 0 2000
    default 700
    help
        How long after audible playback the stricter residual-echo gate stays
        active.

config ESPESP_VOICE_CALLBACK_GATE_HOLD_MS
    int "Voice gate hold time in ms"
    range 0 1000
    default 900
    help
        Once a frame is accepted as speech, keep the gate easier to reopen for
        this long. This reduces chopped words while keeping the echo gate active.

config ESPESP_VOICE_CALLBACK_GATE_RELEASE_PERCENT
    int "Voice gate release threshold percent"
    range 10 100
    default 25
    help
        Percentage of the normal gate threshold used during the hold window.
        Lower values make speech more continuous; higher values reject more
        residual speaker leakage.

config ESPESP_VOICE_CALLBACK_GATE_RELEASE_MIN_AVG_ABS
    int "Voice gate release minimum average amplitude"
    range 0 1000
    default 80
    help
        Minimum average amplitude needed while the gate hold window is active.
        This prevents steady microphone floor noise from being played just
        because a previous speech frame opened the gate.

config ESPESP_VOICE_CALLBACK_GATE_HOLD_GAIN_PERCENT
    int "Voice gate hold gain percent"
    range 0 100
    default 80
    help
        Gain used for weak frames inside the voice hold window. Increasing
        this makes soft syllables and short pauses sound more continuous;
        lowering it rejects more residual speaker leakage.

config ESPESP_VOICE_CALLBACK_GATE_TAIL_MS
    int "Voice gate tail time in ms"
    range 0 1000
    default 350
    help
        Extra low-gain tail kept after speech drops below the release
        threshold. This reduces chopped syllables and abrupt word endings.

config ESPESP_VOICE_CALLBACK_GATE_TAIL_GAIN_PERCENT
    int "Voice gate tail gain percent"
    range 0 100
    default 60
    help
        Gain used during the voice gate tail window. Higher values preserve
        weak word endings; lower values reject more room noise.

config ESPESP_VOICE_CALLBACK_HIGHPASS_FILTER_ENABLED
    bool "Enable microphone high-pass filter"
    default y
    help
        Removes DC offset and low-frequency rumble from the microphone path
        before gate and playback processing.

config ESPESP_VOICE_CALLBACK_HIGHPASS_ALPHA_Q15
    int "Microphone high-pass alpha Q15"
    range 28000 32760
    default 31800
    depends on ESPESP_VOICE_CALLBACK_HIGHPASS_FILTER_ENABLED
    help
        One-pole high-pass coefficient in Q15. Larger values keep more low
        frequency content; smaller values suppress more low-frequency noise.

config ESPESP_VOICE_CALLBACK_NOISE_SUPPRESS_FLOOR_ABS
    int "Playback noise suppression floor amplitude"
    range 0 1000
    default 0
    help
        Optional linear attenuation for frames below this average amplitude
        after they pass the voice gate. The default is 0 because per-sample
        noise shaping can sound distorted on small I2S speakers.

config ESPESP_VOICE_CALLBACK_TASK_STACK_SIZE
    int "Voice callback task stack size"
    range 4096 24576
    default 8192

config ESPESP_VOICE_CALLBACK_I2S_READ_TIMEOUT_MS
    int "I2S read timeout in ms"
    range 100 5000
    default 1000

config ESPESP_VOICE_CALLBACK_I2S_WRITE_TIMEOUT_MS
    int "I2S write timeout in ms"
    range 100 5000
    default 1000

endmenu

menu "Voice client module"

config ESPESP_VOICE_CLIENT_URI
    string "voice-server WebSocket URI"
    default "ws://192.168.1.23:8765/ws"
    help
        Use your computer's LAN IP when testing with server/voice-server/.
        Do not use 127.0.0.1 from the ESP32.

config ESPESP_VOICE_CLIENT_AUTH_TOKEN
    string "Bearer token"
    default ""
    help
        Leave empty for open endpoints. When set, the client sends
        Authorization: Bearer <token> during the handshake.

config ESPESP_VOICE_CLIENT_INPUT_SAMPLE_RATE_HZ
    int "Input PCM sample rate"
    range 8000 48000
    default 48000
    help
        Sample rate declared to voice-server in the start event and used for
        the I2S microphone clock. It must match the actual PCM bytes sent by
        the ESP32. The bundled voice-server example currently uses 48000 Hz.

config ESPESP_VOICE_CLIENT_FRAME_MS
    int "Microphone frame duration in ms"
    range 20 100
    default 40
    help
        Each WebSocket binary frame contains this much raw PCM audio. The
        voice-server docs recommend 20 ms to 100 ms for real-time microphone
        streaming.

config ESPESP_VOICE_CLIENT_SEGMENT_MS
    int "ASR segment duration in ms"
    range 500 10000
    default 1500
    help
        Sent as start.segment_seconds. Smaller values reduce latency but cause
        more ASR requests.

choice ESPESP_VOICE_CLIENT_MIC_SLOT
    prompt "Voice client microphone I2S slot"
    default ESPESP_VOICE_CLIENT_MIC_SLOT_LEFT
    help
        Select the I2S slot used by the microphone. Only one slot is sent as
        mono PCM.

config ESPESP_VOICE_CLIENT_MIC_SLOT_LEFT
    bool "Left"

config ESPESP_VOICE_CLIENT_MIC_SLOT_RIGHT
    bool "Right"

endchoice

config ESPESP_VOICE_CLIENT_MIC_SAMPLE_SHIFT_BITS
    int "Microphone sample right shift bits"
    range 8 16
    default 12
    help
        Controls how 32-bit I2S microphone samples are scaled down to 16-bit
        PCM. Lower values are louder and may clip; higher values are quieter.

config ESPESP_VOICE_CLIENT_ASR_LANGUAGE
    string "ASR language hint"
    default "zh"
    help
        Sent as start.asr.language. Leave empty to omit this override.

config ESPESP_VOICE_CLIENT_TTS_VOICE
    string "TTS voice override"
    default "zh1_voice"
    help
        Sent as start.tts.voice. Leave empty to use the server default voice.

config ESPESP_VOICE_CLIENT_TTS_VOLUME_PERCENT
    int "TTS playback volume percent"
    range 10 100
    default 60
    help
        Digital gain applied to server TTS PCM before writing to I2S. Lower
        this value if playback is too loud, distorted, or clipping.

config ESPESP_VOICE_CLIENT_TTS_LIMIT_PERCENT
    int "TTS soft limit percent"
    range 50 100
    default 90
    help
        Peak limiter applied after TTS volume scaling. Values below 100 leave
        headroom for I2S amplifiers and small speakers.

config ESPESP_VOICE_CLIENT_AEC_ENABLED
    bool "Enable acoustic echo cancellation (AEC)"
    default y
    help
        Enable full-duplex AEC to remove speaker output from the microphone
        signal. Uses an NLMS adaptive filter. When enabled, the microphone
        stays active during TTS playback.

config ESPESP_VOICE_CLIENT_AEC_FILTER_LEN
    int "AEC filter length (taps)"
    range 64 1024
    default 256
    depends on ESPESP_VOICE_CLIENT_AEC_ENABLED
    help
        Number of NLMS filter taps. More taps handle longer echo paths but
        use more CPU and memory. This is the primary parameter that decides
        how much echo-path span the adaptive filter can model. At 16 kHz,
        256 taps = 16 ms of echo path.

config ESPESP_VOICE_CLIENT_AEC_STEP_SIZE_X256
    int "AEC step size (scaled by 256)"
    range 1 256
    default 128
    depends on ESPESP_VOICE_CLIENT_AEC_ENABLED
    help
        NLMS convergence speed. 128 = 0.5 (moderate). Higher values converge
        faster but may be unstable. Lower values are more stable but slower.

config ESPESP_VOICE_CLIENT_AEC_MAX_DELAY_MS
    int "AEC max acoustic delay in ms"
    range 10 500
    default 200
    depends on ESPESP_VOICE_CLIENT_AEC_ENABLED
    help
        Sets the reference-history depth and post-playback tail window.
        The current implementation does not automatically search the best
        delay offset, so increasing this value alone does not replace a
        longer AEC filter length.

config ESPESP_VOICE_CLIENT_CONNECT_TIMEOUT_MS
    int "Connect timeout in ms"
    range 1000 60000
    default 10000

config ESPESP_VOICE_CLIENT_NETWORK_TIMEOUT_MS
    int "Network operation timeout in ms"
    range 1000 30000
    default 5000

config ESPESP_VOICE_CLIENT_RECONNECT_TIMEOUT_MS
    int "Reconnect delay in ms"
    range 1000 60000
    default 10000

config ESPESP_VOICE_CLIENT_PING_INTERVAL_SEC
    int "Ping interval in seconds"
    range 1 300
    default 10

config ESPESP_VOICE_CLIENT_BUFFER_SIZE
    int "WebSocket receive buffer size"
    range 512 16384
    default 4096
    help
        TTS binary frames may be fragmented by this buffer; the client handles
        fragmentation and keeps 16-bit PCM samples aligned.

config ESPESP_VOICE_CLIENT_TASK_STACK_SIZE
    int "WebSocket client task stack size"
    range 6144 32768
    default 12288

config ESPESP_VOICE_CLIENT_I2S_WRITE_TIMEOUT_MS
    int "I2S speaker write timeout in ms"
    range 100 5000
    default 1000

endmenu

menu "Display module"

config ESPESP_DISPLAY_SDA_GPIO
    int "Display I2C SDA GPIO"
    range 0 48 if IDF_TARGET_ESP32S3
    range 0 39
    default 8

config ESPESP_DISPLAY_SCL_GPIO
    int "Display I2C SCL GPIO"
    range 0 48 if IDF_TARGET_ESP32S3
    range 0 39
    default 9

config ESPESP_DISPLAY_I2C_ADDR
    hex "Display I2C address"
    range 0x03 0x77
    default 0x3C
    help
        SSD1306 OLED modules commonly use 0x3C or 0x3D.

config ESPESP_DISPLAY_I2C_HZ
    int "Display I2C clock"
    range 100000 400000
    default 400000

config ESPESP_DISPLAY_TIMEOUT_MS
    int "Display I2C timeout in ms"
    range 10 1000
    default 100

endmenu

endmenu
